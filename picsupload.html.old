<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bilder hochladen</title>
    <link rel="stylesheet" href="picsupload-styles.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="module" src="picsuploadjs.js"></script>
</head>
<body>
    <div class="header-controls">
        <h1>Bilder hochladen (Batch möglich)</h1>
        <div id="status">Verbinde mit Firebase...</div>
        <div class="controls-grid">
            <div>
                <label for="encryptionPassword">Verschlüsselungspasswort</label>
                <input type="password" id="encryptionPassword" placeholder="Passwort eingeben">
            </div>
            <div>
                <label for="schoolYear">Schuljahr</label>
                <input type="text" id="schoolYear" placeholder="Schuljahr eingeben (z.B. 2024-2025)">
            </div>
            <div>
                <label for="classSelector">Klasse</label>
                <input type="text" id="classSelector" placeholder="Klasse eingeben (z.B. E1ME2)">
            </div>
            <div>
                <label for="imageUpload">Bilder auswählen (mehrere möglich, Format: Nachname_Vorname.jpg)</label>
                <input type="file" id="imageUpload" accept="image/*" multiple>
                <div id="previewContainer"></div> <!-- Vorschau für mehrere -->
            </div>
            <div class="button-container">
                <button id="backButton">Zurück zur Hauptseite</button>
                <button id="uploadButton">Hochladen</button>
            </div>
        </div>
    </div>
</body>
</html>